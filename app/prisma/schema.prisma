generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MediaItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  url         String?
  thumbnail   String?
  type        String
  isArchived  Boolean   @default(false)
  filePath    String?   @unique
  metadata    String?
  duration    Int?
  pages       Int?
  size        BigInt?
  lastPos     Float     @default(0)
  rating      Int       @default(0)
  viewCount   Int       @default(0)
  isFavorite  Boolean   @default(false)
  publishedAt DateTime?
  status      String    @default("READY") // READY, PROCESSING, FAILED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  markers     Marker[]
  tags        Tag[]     @relation("MediaItemToTag")
}

model Tag {
  id    String      @id @default(cuid())
  name  String      @unique
  items MediaItem[] @relation("MediaItemToTag")
}

model Marker {
  id        String    @id @default(cuid())
  itemId    String
  time      Int
  label     String
  icon      String?
  createdAt DateTime  @default(now())
  item      MediaItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id               String   @id @default("default")
  markerIcons      String   @default("[\"💦\",\"👄\",\"🍑\",\"🐄\",\"🦶\",\"💕\",\"🚀\",\"🛑\"]")
  autoResume       Boolean  @default(true)
  quickActionMode  String   @default("highlight")
  quickActionIcon  String   @default("✨")
  quickActionLabel String   @default("Highlight")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
